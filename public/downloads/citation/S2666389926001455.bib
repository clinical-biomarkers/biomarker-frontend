@article{masood2026biomarkerkb,
title = {BiomarkerKB: An integrated knowledgebase supporting biomarker-centric exploration of biomedical data},
journal = {Patterns},
publisher={Elsevier},
pages = {101636},
year = {2026},
issn = {2666-3899},
doi = {https://doi.org/10.1016/j.patter.2026.101636},
url = {https://www.sciencedirect.com/science/article/pii/S2666389926001455},
author = {Daniall Masood and Mariia Kim and Jeet Vora and Robel Kahsay and Patrick McNeely and Sean Kim and Cyrus Chun Hong {Au Yeung} and Sujeet Kulkarni and Darren A. Natale and Srinivasan Ramachandran and Shakti Gupta and Mano Maurya and Cristian G. Bologa and Thomas S. DeNapoli and Vincent T. Metzger and Praveen Kumar and Nasheath Ahmed and John Erol Evangelista and Nia Lingam and Sean C. Kelly and Jorge L. Sepulveda and Avi Ma’ayan and Jonathan Silverstein and Deanne M. Taylor and Daniel J. Crichton and Ashish Mahabal and Jeremy J. Yang and Christophe G. Lambert and Shankar Subramaniam and Michael Tiemeyer and Rene Ranzinger and Raja Mazumder},
keywords = {biomarkers, knowledgebase, knowledge graph, biomarker-disease associations, biomarker discovery, data harmonization, data standard},
abstract = {Summary
Biomarkers are essential tools for disease detection, risk assessment, therapeutic monitoring, and precision medicine. However, biomarker data are dispersed across heterogeneous resources, inconsistently reported in the literature, and rarely standardized for computational use. This fragmentation limits reproducibility, cross-study integration, and the discovery of novel biomarker and disease relationships. We developed BiomarkerKB, designed to harmonize and integrate biomarker information under a standardized data model. The model captures both core fields (biomarker entity, disease/condition, and exposure agent) and contextual metadata (specimen, biomarker role, evidence, and provenance). Biomarker data and related annotations were either curated from publications or collected from public resources. The initial release of BiomarkerKB contains over 200,000 biomarker-disease associations spanning genes, proteins, metabolites, glycans, and chemical elements. BiomarkerKB data were ingested into a Neo4j-based knowledge graph that comprises more than 300,000 nodes and 1.2 million edges. A publicly accessible web portal provides a unified framework for biomarker knowledge exploration and discovery.}
}